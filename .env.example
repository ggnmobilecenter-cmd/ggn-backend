# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=https://ggnmobilecenter.com.np

# ---- Database (PostgreSQL recommended; MySQL also supported by Prisma) ----
# Example for PostgreSQL / Supabase:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ggn_mobile?schema=public"
# Example for MySQL / PlanetScale:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/ggn_mobile"

# ---- Auth ----
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
ADMIN_SEED_EMAIL="admin@ggnmobilecenter.com.np"
ADMIN_SEED_PASSWORD="change-this-before-seeding"

# ---- File storage (for job photos/videos, quotation attachments) ----
# Use a cloud storage bucket in production — do not store uploads on the server disk.
STORAGE_PROVIDER="s3"                # s3 | cloudinary | local (local = dev only)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- WhatsApp / SMS / Email notifications ----
# WhatsApp Cloud API (Meta) — used for booking confirmations, status updates
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_NUMBER="9779862564825"

# SMS gateway (e.g. Sparrow SMS, common in Nepal)
SMS_API_TOKEN=""
SMS_SENDER_ID=""

# Email (transactional, e.g. via SMTP or a provider like Resend/SendGrid)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="ggnmobilecenter@gmail.com"

# ---- Analytics (frontend uses these; backend only stores/echoes if needed) ----
GOOGLE_ANALYTICS_ID=""
GOOGLE_SEARCH_CONSOLE_VERIFICATION=""
META_PIXEL_ID=""
